generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model polls {
  id          Int       @id @default(autoincrement())
  question    String
  description String?
  options     options[]
}

model options {
  id      Int    @id @default(autoincrement())
  poll_id Int
  text    String
  votes   Int    @default(0)
  polls   polls  @relation(fields: [poll_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
